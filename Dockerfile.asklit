FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts
COPY . .
ARG NEXT_PUBLIC_ASKLIT_API_URL=https://asklit.suffolklitlab.org
ENV NEXT_PUBLIC_ASKLIT_API_URL=$NEXT_PUBLIC_ASKLIT_API_URL NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM nginxinc/nginx-unprivileged:stable-alpine
COPY deploy/asklit-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/out /usr/share/nginx/html
EXPOSE 8080
