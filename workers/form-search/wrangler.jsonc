{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "courtforms-form-search",
  "main": "index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://courtformsonline.org,https://www.courtformsonline.org",
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "175",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "observability": { "enabled": false },
}
